# Copy this file to .env and fill in real values. Never commit .env itself.
PORT=3001
JWT_SECRET=your-jwt-secret
INTERNAL_SERVICE_SECRET=shared-secret-with-user_service
SERVER_PUBLIC_IP=your.server.public.ip
MAILINGSERVICE=your-mailing-service-url
LINK_PREVIEW_SERVICE_URL=https://your-user-service/api/newsfeed/link-preview

# Postgres
DB_HOST=host
DB_NAME=name
DB_PORT=5432
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-password-here

# Mongo (the cluster host is in connections/index.js)
MONGODB_CLUSTER_PASS=YOUR_MONGO_PASSWORD

# Cassandra (Astra)
CASSANDRA_DB_HOST=YOUR_ASTRA_DB_ID-YOUR_REGION.db.astra.datastax.com
CASSANDRA_DB_NAME=chatterloop
CASSANDRA_DB_KEYSPACE=chatterloop
CASSANDRA_DB_PORT=29080
CASSANDRA_DB_USERNAME=YOUR_ASTRA_CLIENT_ID
CASSANDRA_DB_PASSWORD=YOUR_ASTRA_CLIENT_SECRET
CASSANDRA_DB_TOKEN=AstraCS:YOUR_CLIENT_ID:YOUR_GENERATED_SECRET_TOKEN
CASSANDRA_DB_ENDPOINT=https://YOUR_ASTRA_DB_ID-YOUR_REGION.apps.astra.datastax.com

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=your-redis-password

# RabbitMQ
RABBITMQ_PROTOCOL=amqps
RABBITMQ_USER=user
RABBITMQ_PASS=pass
RABBITMQ_HOST=host
RABBITMQ_PORT=5671
RABBITMQ_VHOST=vhost

# WebRTC (mediasoup) port range
RTC_PORT_BASE=10000
RTC_PORT_MAX=10799

# AI
OPEN_AI_API=https://api.openai.com/v1
OPEN_AI_API_KEY=your-openai-key
OPENAI_MODEL=your-openai-model
GROQ_API=https://api.groq.com/openai/v1
GROQ_API_KEY=your-groq-key
GROQ_MODEL=your-groq-model

# Firebase (push test script, scripts/sendTestPush.js)
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY='{"privateKey": "-----BEGIN PRIVATE KEY-----\nYOUR_KEY_BODY\n-----END PRIVATE KEY-----\n"}'
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/your-service-account
FIREBASE_UNIVERSE_DOMAIN=googleapis.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# File storage (any S3-compatible provider). STORAGE_* names win over SPACES_*
# - use them when moving providers.
STORAGE_PROVIDER=digitalocean
SPACES_REGION=us-east-1
SPACES_BUCKET=your-bucket-name
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_CDN_ENDPOINT=sgp1.cdn.digitaloceanspaces.com
SPACES_KEY=YOUR_SPACES_ACCESS_KEY
SPACES_SECRET=YOUR_SPACES_SECRET_KEY
# Our media domain: new upload links are built on it (reusables/media/storageProvider.js).
STORAGE_PUBLIC_BASE_URL=https://media.neonsystems.net

# Optional
# STORAGE_CORS_ORIGINS=https://chatterloop.app,https://*.chatterloop.app
#                                  origins scripts/storageCors.js allows (default mirrors index.js)
# SPIKE_ORIGIN=https://chatterloop.app   origin scripts/storageSpike.js tests CORS with
